# =============================================================================
# TEST ENVIRONMENT — AN ISOLATED DATABASE
# =============================================================================
#
# This file exists so that running the test suite CANNOT touch the developer's
# working data. Read AGENTS.md -> "Database Protection Rule" before changing
# anything here.
#
# WHY A SEPARATE FILE (and not just a line in .env)
# -------------------------------------------------
# The suite TRUNCATES the tables it uses between tests. Pointing it at the app's
# database destroys whatever the developer was working on, silently and without
# warning. Keeping the test database in `.env.testing` (and `.env.dusk.local`)
# means the destructive behaviour is confined to a file that is safe to delete.
#
# The `.env` file itself points at `database/database.sqlite` — the DEVELOPMENT
# database — and must never be pointed here.
# =============================================================================

APP_NAME=NomNomytics
APP_ENV=testing
APP_KEY=base64:HbnUNIUGFc1MYaWqJJ3+wMV+LKthYBL4Ywov9tnTEKE=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# THE TEST DATABASE.
#
# A dedicated, disposable SQLite file. `tests/Browser/Support/DuskDatabase.php`
# REFUSES TO RUN unless the configured database is one of the known test files,
# so a mis-set path fails loudly instead of wiping real data.
#
# Dusk needs FILE-backed storage (not `:memory:`) because it drives a real browser
# against a SEPARATE `artisan serve` process: each process would get its own empty
# in-memory database, so the browser could never see the fixtures.
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=database/testing.sqlite
DB_FOREIGN_KEYS=true

# WAL keeps the runner and the serve process from deadlocking on a write lock.
DB_JOURNAL_MODE=WAL
DB_BUSY_TIMEOUT=30000

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

# Mail never leaves the machine during a test run.
MAIL_MAILER=log

# No real SMTP sockets in tests.
SMTP_LIVE_CHECK=false

# Roles are seeded fresh per test; a cached permission map would report a
# legitimately-granted permission as missing (a confusing 403).
PERMISSION_CACHE_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
REGISTRATION_DEFAULT_ROLE=Member
# OAuth test configuration for testing
GOOGLE_CLIENT_ID=test-google-id
GOOGLE_CLIENT_SECRET=test-google-secret
MICROSOFT_CLIENT_ID=test-ms-id
MICROSOFT_CLIENT_SECRET=test-ms-secret
FACEBOOK_CLIENT_ID=test-fb-id
FACEBOOK_CLIENT_SECRET=test-fb-secret
X_CLIENT_ID=test-x-id
X_CLIENT_SECRET=test-x-secret
